@page "/analyzeimage"
@attribute [Authorize]
@inject IAnalyzeImageService AnalyzeImageService

<div class="container mt-5">
    <div class="card shadow p-4">
        <h3 class="mb-4 text-center">Analyze Image</h3>

        <EditForm Model="form" OnValidSubmit="HandleSubmit">
            <InputFile OnChange="HandleFileSelected" class="form-control mb-3" />

            <button class="btn btn-primary w-100" disabled="@isLoading">
                @(isLoading ? "Analyzing..." : "Analyze Face")
            </button>
        </EditForm>

        @if (results != null)
        {
            <div class="mt-4">
                @foreach (var r in results)
                {
                    <div class="alert alert-success">
                        <p><strong>Type:</strong> @r.Type</p>
                        <p><strong>Confidence:</strong> @r.Confidence.ToString("F2")%</p>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }
    </div>
</div>

@code {
    private AnalyzeImageFormModel form = new();
    private List<ResponseAnalyzeFacesJson>? results;
    private bool isLoading = false;
    private string? errorMessage;

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        form.ImageFile = e.File;
        results = null;
        errorMessage = null;
    }

    private async Task HandleSubmit()
    {
        if (form.ImageFile == null)
        {
            errorMessage = "Por favor, selecione uma imagem.";
            return;
        }

        try
        {
            isLoading = true;
            results = await AnalyzeImageService.AnalyzeFacesAsync(form.ImageFile);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private class AnalyzeImageFormModel
    {
        public IBrowserFile? ImageFile { get; set; }
    }
}
